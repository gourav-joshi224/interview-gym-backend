# --- Server ---
PORT=3001
HOST=0.0.0.0
# Comma-separated allowlist. Required (and must not be "*") when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000
# Set to the number of reverse proxies in front of the app so rate limiting sees real client IPs.
# TRUST_PROXY=1

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Writes questions and grades answers.
GEMINI_MODEL=gemini-3.8-flash
# Cheap reviewer that checks each question for topic, level and clarity.
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
QUESTION_JUDGE_ENABLED=true
# minimal | low | medium | high. Leave empty to use the model default (use empty for models without thinking levels).
GEMINI_GENERATION_THINKING=low
GEMINI_GRADING_THINKING=medium
GEMINI_TIMEOUT_MS=60000

# --- Firebase Admin (service account from Firebase console > Project settings > Service accounts) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n escapes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Abuse limits ---
MAX_SESSIONS_PER_DAY=30
